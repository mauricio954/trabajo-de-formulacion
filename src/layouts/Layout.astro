                        <li><a href="/capitulo2#herramientas" class="nl sub-link">2.2 Herramientas y Técnicas</a></li>
                      <li><a href="/capitulo2#salidas" class="nl sub-link">2.3 Salidas</a></li>
                    </ul>
                </li>
				<li class="acc-item">
                    <button class="acc-btn">Cap. 03: Árboles del Proyecto <span class="arr">▼</span></button>
                    <ul class="acc-content">
                        <li><a href="/capitulo3#problemas" class="nl sub-link">3.1 Árbol de Problemas</a></li>
                        <li><a href="/capitulo3#objetivos" class="nl sub-link">3.2 Árbol de Objetivos</a></li>
                    </ul>
                </li>
				<!-- CAPÍTULO 04: ANÁLISIS DE ALTERNATIVAS -->
               <li class="acc-item">
               <button class="acc-btn">Cap. 04: Análisis de Alternativas <span class="arr">▼</span></button>
               <ul class="acc-content">
                        <li><a href="/capitulo4#c7-1" class="nl sub-link">4.1 Identificación de Acciones</a></li>
                        <li><a href="/capitulo4#c7-2" class="nl sub-link">4.2 Soluciones Alternativas</a></li>
                        <li><a href="/capitulo4#c7-3" class="nl sub-link">4.3 Evaluación de Viabilidad</a></li>
                        <li><a href="/capitulo4#c7-4" class="nl sub-link">4.4 Plan de la Transformación Digital</a></li>
                        <li><a href="/capitulo4#c7-5" class="nl sub-link">4.5 Matriz de Marco Lógico</a></li>
                        <li><a href="/capitulo4#c7-6" class="nl sub-link">4.6 Doble Diamante</a></li>
                </ul>
            </li>

            <!-- CAPÍTULO 05: DISEÑO CENTRADO EN EL USUARIO -->
        <li class="acc-item">
    <button class="acc-btn">Cap. 05: Diseño Centrado en el Usuario <span class="arr">▼</span></button>
    <ul class="acc-content">
        <li><a href="/capitulo5#fase1" class="nl sub-link">Fase 1 - Empatizar</a></li>
        <li><a href="/capitulo5#fase2" class="nl sub-link">Fase 2 - Definir</a></li>
