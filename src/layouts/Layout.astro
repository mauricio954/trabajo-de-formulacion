<!-- CAPÍTULO 07: GESTIÓN DEL CRONOGRAMA -->
<li class="acc-item">
    <button class="acc-btn">Cap. 07: Gestión del Cronograma <span class="arr">▼</span></button>
    <ul class="acc-content">
        <li><a href="/capitulo7#entradas" class="nl sub-link">7.1 Entradas</a></li>
        <li><a href="/capitulo7#herramientas" class="nl sub-link">7.2 Herramientas y Técnicas</a></li>
        <li><a href="/capitulo7#salidas" class="nl sub-link">7.3 Salidas (Cronograma y Gantt)</a></li>
    </ul>
</li>
<!-- ANEXOS Y REFERENCIAS -->
<li class="acc-item">
    <button class="acc-btn">Anexos y Referencias <span class="arr">▼</span></button>
    <ul class="acc-content">
        <li><a href="/anexo1" class="nl sub-link">Anexo 1: Instrumentos</a></li>
        <li><a href="/anexo2" class="nl sub-link">Anexo 2: Evidencias</a></li>
        <li><a href="/anexo3" class="nl sub-link">Anexo 3: Transcripciones</a></li>
        <li><a href="/referencias" class="nl sub-link">Referencias</a></li>
    </ul>
</li>
            </ul>
        </nav>
    </aside>

    <main class="mc">
        <slot />
    </main>

    <div class="side-backdrop" role="presentation"></div>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const accButtons = document.querySelectorAll('.acc-btn');
            accButtons.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    btn.classList.toggle('open');
                    const content = btn.nextElementSibling;
                    if (content) content.classList.toggle('open');
                });
            });

            // Manejo visual de links activos y navegación a anclas
            const links = document.querySelectorAll('.nm a');
            links.forEach(link => {
                link.addEventListener('click', (e) => {
                    try {
                        links.forEach(l => l.classList.remove('on'));
                        link.classList.add('on');

                        const url = new URL(link.href, location.href);
                        const normalize = (path) => path.replace(/\/+$/, '') || '/';
                        
                        // Si el link apunta a la misma ruta (solo hash), procesar comportamiento SPA
                        if (normalize(url.pathname) === normalize(location.pathname) && url.hash) {
                            e.preventDefault();
                            history.replaceState(null, '', url.hash);
                            
                            // Disparar evento hashchange manualmente para actualizar vista
                            window.dispatchEvent(new Event('hashchange'));
                            
                            // cerrar sidebar en móvil
                            if (typeof side !== 'undefined' && side && window.innerWidth <= 900) side.classList.remove('open');
                        }
                        // En otro caso, permitir la navegación normal (recarga/ruta nueva)
                    } catch (err) {
                        console.error('Menu link handler error', err);
                    }
                });
            });

            // SPA Router: Mostrar solo la sección activa basada en el hash
            const pageHashes = Array.from(document.querySelectorAll('.nm a'))
                .map(link => new URL(link.href, window.location.href))
                .filter(url => url.pathname.replace(/\/+$/, '') === window.location.pathname.replace(/\/+$/, '') && url.hash)
                .map(url => url.hash.slice(1));

            if (pageHashes.length > 0) {
                const updateView = () => {
                    let currentHash = window.location.hash.slice(1);
                    
                    // Si no hay hash o no es válido para esta página, usar el primero
                    if (!currentHash || !pageHashes.includes(currentHash)) {
                        currentHash = pageHashes[0];
                    }

                    pageHashes.forEach(id => {
                        const el = document.getElementById(id);
                        if (el) {
                            if (id === currentHash) {
                                el.style.display = 'block';
                                setTimeout(() => { el.style.opacity = '1'; el.style.transform = 'none'; }, 10);
                            } else {
                                el.style.display = 'none';
                                el.style.opacity = '0';
                                el.style.transform = 'translateY(15px)';
                            }
                        }
                    });
                    
                    // Scroll al inicio suavemente
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                };
                
                updateView();
                window.addEventListener('hashchange', updateView);
            }

            // Barra de progreso simple al hacer scroll
            const prog = document.getElementById('prog');
            const updateProg = () => {
                const doc = document.documentElement;
                const scrollTop = doc.scrollTop || document.body.scrollTop;
                const scrollHeight = doc.scrollHeight - doc.clientHeight;
                const pct = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
                if (prog) prog.style.width = pct + '%';
            };
            window.addEventListener('scroll', updateProg);
            window.addEventListener('resize', updateProg);
            updateProg();

            // Sidebar toggle for small screens
            const side = document.querySelector('.side');
            const toggle = document.querySelector('.side-toggle');
            const backdrop = document.querySelector('.side-backdrop');

            const closeSide = () => side.classList.remove('open');
            const openSide = () => side.classList.add('open');

            if (toggle && side) {
                toggle.addEventListener('click', (e) => {
                    e.stopPropagation();
                    side.classList.toggle('open');
                });
            }

            if (backdrop) {
                backdrop.addEventListener('click', closeSide);
            }

            // Collapse sidebar by default on small screens
            const setInitialSideState = () => {
                if (window.innerWidth <= 900 && side) {
                    side.classList.remove('open');
                } else if (side) {
                    side.classList.add('open');
                }
            };
            setInitialSideState();
            window.addEventListener('resize', setInitialSideState);
        });
    </script>
</body>
</html>