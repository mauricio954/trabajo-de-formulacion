            </tr>
            <tr>
              <td class="code">1.3.4.1</td><td>Redactar SOPs flujo venta-stock-despacho</td><td>Analista Cal.</td>
              <td class="num">3</td><td class="num">24</td><td class="num">25</td><td class="num">600</td><td class="num">30</td><td class="num">630</td><td>EDT Cap. 6</td>
