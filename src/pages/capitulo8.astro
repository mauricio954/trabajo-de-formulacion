            <tr>
              <td class="code">1.3.1.1</td><td>Diseñar el modelo de datos</td><td>Analista Sist.</td>
              <td class="num">3</td><td class="num">24</td><td class="num">25</td><td class="num">600</td><td class="num">—</td><td class="num">600</td><td>EDT Cap. 6</td>
