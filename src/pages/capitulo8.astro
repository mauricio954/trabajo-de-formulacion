            </tr>
            <tr>
              <td class="code">1.1.3</td><td>Informes de avance semanales</td><td>Líder</td>
              <td class="num">15</td><td class="num">120</td><td class="num">30</td><td class="num">3,600</td><td class="num">—</td><td class="num">3,600</td><td>EDT Cap. 6</td>
            </tr>
            <!-- 1.2 Diagnóstico -->
            <tr><td colspan="10" style="background:#f0fdf4;font-weight:700;color:#15803d;">1.2 Diagnóstico y Requisitos</td></tr>
            <tr>
              <td class="code">1.2.1</td><td>Observación directa del flujo actual</td><td>Analista Sist.</td>
              <td class="num">2</td><td class="num">16</td><td class="num">25</td><td class="num">400</td><td class="num">30</td><td class="num">430</td><td>Lista Cap. 7</td>
            </tr>
            <tr>
              <td class="code">1.2.4</td><td>Auditoría de infraestructura tecnológica</td><td>Analista Infra.</td>
              <td class="num">2</td><td class="num">16</td><td class="num">27</td><td class="num">432</td><td class="num">30</td><td class="num">462</td><td>Lista Cap. 7</td>
            </tr>
            <tr>
              <td class="code">1.2.5</td><td>Redactar fichas de requisitos REQ-01 a REQ-10</td><td>Analista Sist.</td>
              <td class="num">4</td><td class="num">32</td><td class="num">25</td><td class="num">800</td><td class="num">—</td><td class="num">800</td><td>Lista Cap. 7</td>
            </tr>
