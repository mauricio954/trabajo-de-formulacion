            </tr>
            <!-- 1.4 Fase 2 -->
            <tr><td colspan="10" style="background:#faf5ff;font-weight:700;color:#7c4dff;">1.4 Fase 2 — Integrar</td></tr>
            <tr>
              <td class="code">1.4.1.1</td><td>Seleccionar servidor de despliegue</td><td>Analista Infra.</td>
              <td class="num">1</td><td class="num">8</td><td class="num">27</td><td class="num">216</td><td class="num">200</td><td class="num">416</td><td>EDT Cap. 6</td>
            </tr>
