<style>
    .gantt-container {
        width: 100%;
        background-color: #fff;
        border-radius: 8px;
        color: #333;
        font-family: 'Segoe UI', Arial, sans-serif;
    }
    .gantt-container h1 {
        color: #1e293b;
        font-size: 24px;
        margin-bottom: 5px;
        border-bottom: 2px solid #3b82f6;
        padding-bottom: 10px;
    }
    .gantt-container h2 {
        color: #334155;
        font-size: 18px;
        margin-top: 30px;
        margin-bottom: 15px;
    }
    .meta-info {
        background-color: #f8fafc;
        padding: 15px;
        border-radius: 6px;
        margin-bottom: 25px;
        font-size: 14px;
        border-left: 4px solid #3b82f6;
    }
    .meta-info table {
        width: auto;
        border: none;
    }
    .meta-info td {
        padding: 4px 15px 4px 0;
        border: none;
        font-weight: 500;
    }
    .meta-info td.label {
        color: #64748b;
    }
    .gantt-container table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        margin-bottom: 40px;
    }
    .gantt-container th {
        background-color: #0f172a;
        color: #fff;
        font-weight: 600;
        text-align: left;
        padding: 10px 12px;
    }
    .gantt-container td {
        padding: 8px 12px;
        border-bottom: 1px solid #e2e8f0;
    }
    tr.root {
        background-color: #e2e8f0;
        font-weight: bold;
    }
    tr.phase {
        background-color: #f1f5f9;
        font-weight: bold;
        color: #1e3a8a;
    }
    tr.milestone {
        background-color: #fef9c3;
        font-weight: bold;
    }
    .indent-1 { padding-left: 25px; }
    .indent-2 { padding-left: 45px; }
    
    /* Gantt Chart Styling */
    .gantt-wrapper {
        overflow-x: auto;
        margin-top: 20px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 15px;
    }
    .gantt-table {
        width: 100%;
        border-collapse: collapse;
    }
    .gantt-header-row th {
        background-color: #1e293b;
        text-align: center;
        font-size: 12px;
        padding: 6px;
        border: 1px solid #334155;
    }
    .gantt-row td {
        padding: 6px 8px;
        height: 32px;
        font-size: 12px;
        border: 1px solid #e2e8f0;
    }
    .gantt-bar-container {
        position: relative;
        width: 100%;
        height: 100%;
        background-color: #f8fafc;
        min-width: 500px;
    }
    .gantt-bar {
        position: absolute;
        height: 14px;
        top: 9px;
        border-radius: 3px;
    }
    .gantt-bar.root-bar {
        background-color: #475569;
    }
    .gantt-bar.phase-bar {
        background-color: #2563eb;
    }
    .gantt-bar.task-bar {
        background-color: #38bdf8;
        border: 1px solid #0284c7;
    }
    .gantt-bar.milestone-bar {
        width: 10px !important;
        height: 10px;
        background-color: #dc2626;
        transform: rotate(45deg);
        top: 11px;
    }
    .badge {
        background-color: #ef4444;
        color: white;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: bold;
    }
</style>

