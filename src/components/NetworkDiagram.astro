<script is:inline>
  function drawArrow(svg, fromId, toId, type) {
    const from = document.querySelector(`[data-id="${fromId}"]`);
    const to = document.querySelector(`[data-id="${toId}"]`);
    if (!from || !to) return;
    
    const canvas = document.getElementById('nd-canvas');
    const cr = canvas.getBoundingClientRect();
    const fr = from.getBoundingClientRect();
    const tr = to.getBoundingClientRect();
    
    let x1, y1, x2, y2, d;
    
    if (type === 'CC') {
      x1 = fr.left - cr.left + fr.width / 2;
      y1 = fr.top - cr.top;
      x2 = tr.left - cr.left + tr.width / 2;
      y2 = tr.top - cr.top;
      
      const h = Math.abs(x2 - x1) * 0.25 + 30; // dynamic height for loop curvature
      d = `M${x1},${y1} C${x1},${y1 - h} ${x2},${y2 - h} ${x2},${y2}`;
    } else {
      x1 = fr.left - cr.left + fr.width;
      y1 = fr.top - cr.top + fr.height / 2;
      x2 = tr.left - cr.left;
      y2 = tr.top - cr.top + tr.height / 2;
      
      const cx1 = x1 + (x2 - x1) * 0.5;
      const cy1 = y1;
      const cx2 = x1 + (x2 - x1) * 0.5;
      const cy2 = y2;
      d = `M${x1},${y1} C${cx1},${cy1} ${cx2},${cy2} ${x2},${y2}`;
    }
    
    const isCrit = from.classList.contains('crit') && to.classList.contains('crit');
    const color = type === 'CC' ? '#3b82f6' : (isCrit ? '#ef4444' : '#64748b');
    const marker = type === 'CC' ? 'url(#mcc)' : (isCrit ? 'url(#mcrit)' : 'url(#mfc)');
    const dash = type === 'CC' ? '5,3' : 'none';
    
    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('d', d);
    path.setAttribute('fill', 'none');
    path.setAttribute('stroke', color);
    path.setAttribute('stroke-width', isCrit ? '2.2' : '1.5');
    path.setAttribute('stroke-dasharray', dash);
    path.setAttribute('marker-end', marker);
    svg.appendChild(path);
  }

