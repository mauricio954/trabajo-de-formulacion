      <div class="nname">Validar compatibilidad Odoo</div>
      <div class="ndur">1 día · CRÍTICA</div>
    </div>
    <!-- ID28 paralela (CC desde ID26) -->
    <div class="nd-node par" style="left:2420px; top:725px;">
      <div class="nid">ID 28 · 2d</div>
      <div class="nname">Política respaldo datos</div>
      <div class="ndur">Holgura + (CC)</div>
    </div>
    <!-- ID22 crítica -->
    <div class="nd-node crit" style="left:2420px; top:465px;">
      <div class="nid">ID 22 · 3d</div>
      <div class="nname">Desplegar base datos ligera</div>
      <div class="ndur">3 días · CRÍTICA</div>
    </div>
    <!-- ID27 crítica -->
    <div class="nd-node crit" style="left:2420px; top:585px;">
      <div class="nid">ID 27 · 1d</div>
      <div class="nname">Firmar SOPs</div>
      <div class="ndur">1 día · CRÍTICA</div>
    </div>
    <!-- ID29 paralela -->
    <div class="nd-node par" style="left:2620px; top:725px;">
      <div class="nid">ID 29 · 1d</div>
      <div class="nname">Firmar política respaldo</div>
      <div class="ndur">Holgura +</div>
    </div>
    <!-- ID23 crítica -->
